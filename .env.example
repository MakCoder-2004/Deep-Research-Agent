# Copy to .env for local development. Placeholder names only — never commit real secrets.
# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# Runtime
ENVIRONMENT=development
DATABASE_PATH=data/research.db
REPORTS_DIR=data/reports
REPORT_RETENTION_DAYS=90
SESSION_TTL_HOURS=24
SESSION_MAX_INTERACTIONS=6

# Budgets and limits (PLAN section 17 defaults)
MAX_CONCURRENT_JOBS=3
MAX_ACTIVE_PER_USER=1
REQUESTS_PER_USER_PER_DAY=10
DEEP_REQUESTS_PER_USER_PER_DAY=3
SEARCH_SUBQUERIES_PER_JOB=6
SEARCH_TOOL_CONCURRENCY=1
SEARCH_PROVIDER_CONCURRENCY=1
SEARCH_TOOL_LIMITS=
SEARCH_PROVIDER_LIMITS=
SOURCES_PER_JOB=12
CHARS_PER_SOURCE=20000
MAX_HEADINGS=100
HEADING_MAX_CHARS=500
TITLE_MAX_CHARS=500
METADATA_MAX_CHARS=300
MAX_QUOTATIONS=5
QUOTATION_MAX_CHARS=280
MAX_LINKS=100
READER_CONTEXT_CHARS=40000
REPAIR_CYCLES=1
JOB_TIMEOUT_SECONDS=300
SEARCH_CACHE_GENERAL_SECONDS=21600
SEARCH_CACHE_NEWS_SECONDS=1800
PAGE_CACHE_GENERAL_SECONDS=86400
PAGE_CACHE_NEWS_SECONDS=3600

# Safe extraction
EXTRACTION_CONNECT_TIMEOUT_SECONDS=5
EXTRACTION_READ_TIMEOUT_SECONDS=20
EXTRACTION_WRITE_TIMEOUT_SECONDS=5
EXTRACTION_POOL_TIMEOUT_SECONDS=5
EXTRACTION_TOTAL_TIMEOUT_SECONDS=60
EXTRACTION_DNS_TIMEOUT_SECONDS=5
MAX_REDIRECTS=3
MAX_RESPONSE_BYTES=2000000
RESPECT_ROBOTS_TXT=true
ROBOTS_CACHE_TTL_SECONDS=3600
ROBOTS_CACHE_MAX_ENTRIES=256
JINA_READER_ENABLED=false
JINA_READER_BASE_URL=https://r.jina.ai/
JINA_READER_API_KEY=

# LLM providers (keys injected at runtime)
GROQ_API_KEY=
OPENROUTER_API_KEY=
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=

# Search tools (keys injected at runtime)
TAVILY_API_KEY=
BRAVE_API_KEY=
EXA_API_KEY=
SERPAPI_API_KEY=
GITHUB_TOKEN=
SEARXNG_BASE_URL=
STACKEXCHANGE_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
NCBI_API_KEY=
CROSSREF_MAILTO=
OPENALEX_MAILTO=
NCBI_EMAIL=
NCBI_TOOL=deep-research-agent
OFFICIAL_ALLOWED_DOMAINS=

# Capability -> model resolution (no hard-coded model names in source)
LLM_PROVIDER_PRIORITY=groq,openrouter,cloudflare
MODEL_MAP=

# LangSmith observability (optional; local logs/SQLite remain authoritative when disabled)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=deep-research-agent
LANGSMITH_WORKSPACE_ID=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_ENVIRONMENT=development
LANGSMITH_TRACE_CONTENT=false
LANGSMITH_TRACE_SENSITIVE_CONTENT=false
LANGSMITH_SAMPLE_RATE=1.0
