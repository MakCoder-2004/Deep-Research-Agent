# Copy to .env for local development. Placeholder names only — never commit real secrets.
# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# Runtime
ENVIRONMENT=development
DATABASE_PATH=data/research.db
REPORTS_DIR=data/reports
REPORT_RETENTION_DAYS=90
SESSION_TTL_HOURS=24
SESSION_MAX_INTERACTIONS=6

# Budgets and limits (PLAN section 17 defaults)
MAX_CONCURRENT_JOBS=3
MAX_ACTIVE_PER_USER=1
REQUESTS_PER_USER_PER_DAY=10
DEEP_REQUESTS_PER_USER_PER_DAY=3
SEARCH_SUBQUERIES_PER_JOB=6
SOURCES_PER_JOB=12
CHARS_PER_SOURCE=20000
READER_CONTEXT_CHARS=40000
REPAIR_CYCLES=1
JOB_TIMEOUT_SECONDS=300
SEARCH_CACHE_GENERAL_SECONDS=21600
SEARCH_CACHE_NEWS_SECONDS=1800
PAGE_CACHE_GENERAL_SECONDS=86400
PAGE_CACHE_NEWS_SECONDS=3600

# LLM providers (keys injected at runtime)
GROQ_API_KEY=
OPENROUTER_API_KEY=
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=

# Search tools (keys injected at runtime)
TAVILY_API_KEY=
BRAVE_API_KEY=

# Capability -> model resolution (no hard-coded model names in source)
LLM_PROVIDER_PRIORITY=groq,openrouter,cloudflare
MODEL_MAP=

# LangSmith observability (optional; local logs/SQLite remain authoritative when disabled)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=deep-research-agent
LANGSMITH_WORKSPACE_ID=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_ENVIRONMENT=development
LANGSMITH_TRACE_CONTENT=true
LANGSMITH_TRACE_SENSITIVE_CONTENT=false
LANGSMITH_SAMPLE_RATE=1.0
