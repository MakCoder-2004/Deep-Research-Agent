{
  "$schema": "https://opencode.ai/config.json",
  "subagent_depth": 0,
  "skills": {
    "paths": [
      ".agents/skills"
    ]
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 8
  },
  "permission": {
    "skill": {
      "*": "ask"
    }
  },
  "mcp": {
    "docs-langchain": {
      "type": "remote",
      "url": "https://docs.langchain.com/mcp",
      "enabled": true
    },
    "reference-langchain": {
      "type": "remote",
      "url": "https://reference.langchain.com/mcp",
      "enabled": true
    }
  }
}
