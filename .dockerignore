# Secrets and local environment
.env
.env.*
!.env.example

# Local data (mounted at runtime, never baked into image)
data/
*.db
*.db-wal
*.db-shm
*.pem
*.key

# Virtual envs (never bake host venv)
.venv/
venv/

# Tests and caches
tests/
.pytest_cache/
.mypy_cache/
.ruff_cache/
__pycache__/
*.pyc
htmlcov/
.coverage
.coverage.*
coverage.xml

# Build artifacts
dist/
build/
*.egg-info/

# Editor files
.vscode/
.idea/
*.swp

# Git metadata
.git/
